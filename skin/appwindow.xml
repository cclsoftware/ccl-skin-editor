<?xml version="1.0" encoding="utf-8"?>
<Skin>

	<Styles>
	
		<Style name="SourceCode" inherit="Standard.WindowBackground">
			<Font name="textfont" themeid="StandardUI" size="12"/>
			<Color name="textcolor" color="@Main.LabelColor"/>
			<Align name="textalign" align="left top"/>
		</Style>
		
		<Style name="AboutLabel" inherit="Standard.Label"/>

		<Style name="FormEditorTreeView" inherit="Standard.TreeView">
			<Color name="SkinViewItem.Disabled.backcolor" color="#FF00007F"/>
			<Color name="SkinViewItem.ParentDisabled.backcolor" color="#FFBABA7F"/>
		</Style>

	</Styles>
	
	<Forms>
	
		<!-- ******************************************************************************************** -->
        <!-- Application Window -->
        <!-- ******************************************************************************************** -->

		<Form name="ApplicationWindow" attach="all" windowstyle="windowstyle sizable center restoresize inflate maximize" options="colorize" style="Standard.WindowBackground">
            <using controller="object://hostapp/Navigator">
                <View name="Navigator" width="1200" height="600" attach="all"/>
            </using>			
		</Form>
		
        <Form name="Navigator" width="1200" height="600" attach="all">
            <View name="contentFrame" width="1200" height="600" attach="all"/>
        </Form>

		<Form name="HomePage">
			<Vertical>
				<Label title=""/>
			</Vertical>
		</Form>
		
		<Form name="SectionHeader">
			<DialogGroup options="secondary" attach="all">
				<Horizontal margin="2" spacing="0">
					<Label title="$title" attach="left vcenter"/>					
				</Horizontal>
			</DialogGroup>
		</Form>
		
		<!-- ******************************************************************************************** -->
        <!-- Document View -->
        <!-- ******************************************************************************************** -->

		<Form name="SkinDocumentView" attach="all">
			<using controller="SkinEditor">
			<Horizontal attach="all" spacing="5" options="unifysizes">
					<Vertical margin="0" spacing="2" attach="all">
						<define title="Forms">
							<View name="SectionHeader" width="300" attach="left right top"/>
						</define>
						<Horizontal margin="0">
							<Button icon="VSImageLibrary/AddForm" width="24" height="24" command.category="Skin" command.name="Add Form" tooltip="@cmd.title[]"/>
						</Horizontal>
						<TreeView name="formTreeModel" width="300" height="600" options="noroot selection header" scrolloptions="border autohideboth" attach="all"/>
					</Vertical>

					<Divider width="5" height="600" attach="top bottom"/>
					
					<Vertical margin="0" spacing="0" attach="all">
						<using controller="FormEditor">
							<TreeView name="treeModel" width="300" height="300" style="FormEditorTreeView" options="noroot selection selectfullwidth" scrolloptions="border autohideboth" attach="all"/>							
						</using>
						<Divider height="5" width="300" attach="left right"/>
						<using controller="FormInspector">
							<View name="SkinItemInspector" attach="all"/>
						</using>
					</Vertical>
					
					<Divider width="5" height="600" attach="top bottom"/>
					
					<using controller="FormEditor">
						<Vertical margin="0" spacing="0" attach="all">
							<Horizontal margin="0" height="25">
								<CheckBox name="showBoundingBoxes" title="Show bounding boxes" attach="vcenter"/>
								<CheckBox name="snapToGrid" title="Snap to grid" attach="vcenter"/>
								<ValueBox name="gridSize" width="50" height="20" attach="vcenter"/>
								<!-- Zoom implementation not finished
								<Label title="Zoom" attach="vcenter"/>
								<ValueBox name="zoomFactor" width="50" height="20" attach="vcenter"/>
								-->
							</Horizontal>
							
							<!-- TODO: add scroll view for edit view... -->
							<View name="EditView" width="800" height="480" attach="all"/>

							<Divider height="5" width="800" attach="left right"/>
							
							<TextEditor name="../sourceCode" width="800" height="95" options="border" attach="all" style="SourceCode"/>
						</Vertical>
					</using>
					
					<Divider width="5" height="600" attach="top bottom"/>
					
					<Vertical margin="0" spacing="0" attach="all">
						<TabView width="300" height="300" attach="all">
							<ListView title="Controls" name="classListModel" width="300" height="300" options="selection exclusive" viewtype="icons" scrolloptions="border autohideboth" attach="all"/>
							<Vertical title="Assets" margin="0" spacing="2" attach="all">
								<Horizontal margin="2" spacing="2">
									<Button icon="VSImageLibrary/AddFont" width="24" height="24" command.category="Skin" command.name="Add Font" tooltip="@cmd.title[]"/>
									<Button icon="VSImageLibrary/AddImage" width="24" height="24" command.category="Skin" command.name="Add Image" tooltip="@cmd.title[]"/>
									<Button icon="VSImageLibrary/AddStyleRule" width="24" height="24" command.category="Skin" command.name="Add Style" tooltip="@cmd.title[]"/>									
								</Horizontal>
								<TreeView  name="assetTreeModel" width="300" height="280" options="noroot selection" scrolloptions="border autohideboth" attach="all"/>
							</Vertical>
						</TabView>
						<!--
						<define title="Properties">
							<View name="SectionHeader" width="300" attach="left right top"/>
						</define>
						-->
						<using controller="AssetInspector">
							<View name="SkinItemInspector" attach="all" width="300" height="200"/>
						</using>
						<!--
						<define title="Preview">
							<View name="SectionHeader" width="300" attach="left right top"/>
						</define>
						-->
						<DialogGroup options="secondary" attach="all">
							<Picture provider="imageProvider" options="fitimage" width="300" height="50" attach="all"/>
						</DialogGroup>
					</Vertical>					
			</Horizontal>
			</using>
		</Form>
		
		<Form name="SkinItemInspector">
			<Vertical margin="0" spacing="0" attach="all">
				<ListView name="listModel" width="300" height="276" options="header selection" scrolloptions="border autohideboth" attach="all"/>
				<Horizontal margin="2" spacing="2" attach="left right bottom">
					<Button name="addAttribute" icon="VSImageLibrary/AddThin" width="20" height="20" tooltip="Add Attribute..."/>
					<Button name="removeAttribute" icon="VSImageLibrary/RemoveThin" width="20" height="20" tooltip="Remove Attribute"/>
				</Horizontal>
			</Vertical>
		</Form>
		
		<!-- ******************************************************************************************** -->
        <!-- Document Settings -->
        <!-- ******************************************************************************************** -->

		<Form name="SkinDocumentSettings" title="Skin Settings" buttons="okay cancel">
			<Vertical margin="0" options="unifysizes">
				<DialogGroup title="Editor" attach="left right">
					<Vertical attach="all">
						<Space/>
						<Horizontal margin="0" spacing="0" attach="left right">
							<Label title="Background color" attach="vcenter"/>
							<Space/>
							<ColorBox width="40" height="20" name="backColor" attach="vcenter"/>
							<Link name="selectBackColor" title="Select..." attach="vcenter"/>
							<Space attach="left right"/>
						</Horizontal>
					</Vertical>
				</DialogGroup>
				<DialogGroup title="Defaults" attach="all">
					<Vertical attach="all">
						<Space/>
						<Table margin="0" columns="2">
							<Label title="Form Width"/>
							<ValueBox name="formWidth" width="50"/>
							<Label title="Form Height"/>
							<ValueBox name="formHeight" width="50"/>
						</Table>
						<ListView name="defaultsList" width="500" height="200" options="selection" scrolloptions="border autohidev" attach="all"/>
						<Horizontal margin="2" spacing="2">
							<Button name="addDefault" icon="VSImageLibrary/AddThin" width="20" height="20" tooltip="Add Default..."/>
							<Button name="removeDefault" icon="VSImageLibrary/RemoveThin" width="20" height="20" tooltip="Remove Default"/>
							<Button name="editDefault" icon="VSImageLibrary/Edit" width="20" height="20" tooltip="Edit Default..."/>
						</Horizontal>
					</Vertical>
				</DialogGroup>
			</Vertical>
		</Form>
		
		<!-- ******************************************************************************************** -->
        <!-- About -->
        <!-- ******************************************************************************************** -->
		
		<?xstring off?>
		<Form name="AboutApplication" title="About $APPNAME">
			<Horizontal margin="20">
				<ImageView image="AppIcon" width="256" height="256" options="fitimage"/>
				<Vertical margin="0" spacing="0">
					<Space/>
					<Space/>
					<TextBox name="appNameAndVersion" height="15" options="transparent" style="AboutLabel" attach="hfit"/>
					<Label title="GUI Builder for $CCLNAME&reg;" style="AboutLabel"/>
					<Space/>
					<Space/>
					<Label title="Copyright &copy; $COPYYEAR $CCLAUTHOR. All Rights Reserved" style="AboutLabel"/>
					<Anchor url="https://ccl.dev">
						<Link title="For more information, please visit ccl.dev." style="AboutLabel"/>
					</Anchor>
					<Space/>
					<Space/>
					<Anchor url="local://$deployment/license/">				
						<Link title="See license folder for 3rd party software used in this product" style="AboutLabel"/>
					</Anchor>
					<!--
					<Space/>
					<Space/>
					<Space/>
					<Space/>
					<DialogButton result="close" attach="hcenter"/>
					-->
				</Vertical>
			</Horizontal>
		</Form>
		<?xstring?>
		
	</Forms>
</Skin>

