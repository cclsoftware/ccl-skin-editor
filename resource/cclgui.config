<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
	<Attribute id="GUI.AppearanceMode" value="light"/>

	<!-- Windows -->
	<Attribute id="CCL.Win32.MultiTouchEnabled" value="1"/>

	<!-- OS X -->
	<Attribute id="CCL.OSX.TransparentTitlebar" value="1"/>
	<Attribute id="CCL.OSX.ColoredTitlebar" value="1"/>

	<!-- Cross-platform -->
	<Attribute id="GUI.ContextMenu.UseExtendedMenu" value="1"/>
</Configuration>
